# Optional: without these, the existing browser-only demo remains available.
# Create a Supabase project, apply supabase/migrations, then use its PUBLIC key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
# Legacy anon keys also work as VITE_SUPABASE_ANON_KEY.
# Never use a service_role key or sb_secret_ key in any VITE_ variable.
